            <attDef ident="type" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0" />
          </attList>
        </elementSpec>
        <elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude" rend="change" module="transcr" xml:id="gi-delSpan" ident="delSpan" ns="http://www.tei-c.org/ns/1.0">
          <classes />
          <content autoPrefix="true">
            <empty />
          </content>
          <constraintSpec ident="delSpan-requires-spanTo" scheme="schematron" xml:lang="en">
            <constraint>
              <sch:rule context="tei:delSpan">
                <sch:assert test="@spanTo">
                                    The @spanTo attribute of
                                    &lt;
                                    <sch:name />&gt; is required.
                                </sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <constraintSpec ident="delSpan-requires-spanTo-fr" scheme="schematron" xml:lang="fr">
            <constraint>
              <sch:rule context="tei:delSpan">
                <sch:assert test="@spanTo">
                                    L'attribut spanTo est
                                    requis.
                                </sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <attList org="group">
            <attDef ident="change" mode="replace" usage="req" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="string" />
              </datatype>
            </attDef>
            <attDef ident="spanTo" mode="replace" usage="req" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="string" />
              </datatype>
            </attDef>
            <attDef ident="type" mode="replace" usage="req" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="NCName" />
              </datatype>
              <valList type="open" mode="add">
                <valItem ident="deselection" mode="add" />
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="req" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="NCName" />
              </datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude" rend="change" module="transcr" xml:id="gi-fw" ident="fw" ns="http://www.tei-c.org/ns/1.0">
          <classes />
          <content autoPrefix="true">
            <alternate minOccurs="1" maxOccurs="unbounded">
