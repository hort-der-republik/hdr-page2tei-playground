        </elementSpec>
        <elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" rend="change" module="textstructure" xml:id="gi-div" ident="div" ns="http://www.tei-c.org/ns/1.0">
          <gloss versionDate="2017-06-13" xml:lang="de">Textabschnitt</gloss>
          <desc versionDate="2017-06-13" xml:lang="de">enthält einen Unterabschnitt in Vorspann
            (front), Textkörper oder Nachspann (back) eines Textes.</desc>
          <classes />
          <content autoPrefix="true">
            <alternate minOccurs="0" maxOccurs="unbounded">
              <elementRef key="div" minOccurs="1" maxOccurs="1" />
              <elementRef key="metamark" minOccurs="1" maxOccurs="1" />
              <elementRef key="p" minOccurs="1" maxOccurs="1" />
              <elementRef key="byline" minOccurs="1" maxOccurs="1" />
              <elementRef key="cb" minOccurs="1" maxOccurs="1" />
              <elementRef key="dateline" minOccurs="1" maxOccurs="1" />
              <elementRef key="fw" minOccurs="1" maxOccurs="1" />
              <elementRef key="head" minOccurs="1" maxOccurs="1" />
              <elementRef key="anchor" minOccurs="1" maxOccurs="1" />
              <elementRef key="gap" minOccurs="1" maxOccurs="1" />
              <elementRef key="quote" minOccurs="1" maxOccurs="1" />
            </alternate>
          </content>
          <constraintSpec ident="abstractModel-structure-div-in-l" scheme="schematron" xml:lang="en">
            <constraint>
              <sch:rule context="tei:l//tei:div">
                <sch:assert test="ancestor::tei:floatingText">
                                    Abstract model
                                    violation: Metrical lines (&lt;l&gt; elements) may not contain
                                    higher-level structural elements such as &lt;div&gt;, unless
                                    &lt;div&gt; is a descendant of &lt;floatingText&gt;.
                                </sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <constraintSpec ident="abstractModel-structure-div-in-ab-or-p" scheme="schematron" xml:lang="en">
            <constraint>
              <sch:rule context="tei:div">
                <sch:report test="(ancestor::tei:p or ancestor::tei:ab) and not(ancestor::tei:floatingText)">
                                    Abstract model violation: &lt;p&gt; and &lt;ab&gt; may not
                                    contain higher-level structural elements such as &lt;div&gt;,
                                    unless &lt;div&gt; is a descendant of &lt;floatingText&gt;.
                                </sch:report>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <attList org="group">
            <attDef ident="change" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="string" />
              </datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="string" />
              </datatype>
            </attDef>
            <attDef ident="next" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="string" />
              </datatype>
            </attDef>
            <attDef ident="part" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="NCName" />
              </datatype>
              <valList type="closed" mode="add">
                <valItem ident="F" mode="add" />
                <valItem ident="M" mode="add" />
                <valItem ident="I" mode="add" />
              </valList>
            </attDef>
            <attDef ident="prev" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="string" />
              </datatype>
            </attDef>
            <attDef ident="type" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="NCName" />
              </datatype>
              <valList type="open" mode="add">
                <valItem ident="add-block" mode="add" />
                <valItem ident="advertisement" mode="add" />
                <valItem ident="article" mode="add" />
                <valItem ident="newspaper-clipping" mode="add" />
                <valItem ident="notepad-paper" mode="add" />
                <valItem ident="print-proof" mode="add" />
                <valItem ident="print-publ" mode="add" />
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="NCName" />
              </datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" rend="change" module="textstructure" xml:id="gi-byline" ident="byline" ns="http://www.tei-c.org/ns/1.0">
          <gloss versionDate="2017-06-13" xml:lang="de">Verfasserzeile</gloss>
