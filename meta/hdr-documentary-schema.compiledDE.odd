              </datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude" rend="change" ident="metamark" xml:id="gi-metamark" module="transcr" ns="http://www.tei-c.org/ns/1.0">
          <classes />
          <content autoPrefix="true">
            <alternate minOccurs="1" maxOccurs="unbounded">
              <macroRef key="hdr.inline" />
            </alternate>
          </content>
          <attList org="group">
            <attDef ident="function" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="NCName" />
              </datatype>
              <valList type="closed" mode="add">
                <valItem ident="add" mode="add" />
                <valItem ident="addition" mode="add" />
                <valItem ident="deletion" mode="add" />
                <valItem ident="font" mode="add" />
                <valItem ident="insertion" mode="add" />
                <valItem ident="intervention" mode="add" />
