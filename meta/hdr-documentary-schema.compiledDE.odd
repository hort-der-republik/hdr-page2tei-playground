        <elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" rend="change" module="gaiji" ident="g" xml:id="G" ns="http://www.tei-c.org/ns/1.0">
          <classes />
          <content autoPrefix="true">
