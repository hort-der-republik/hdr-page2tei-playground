        <elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude" rend="change" module="transcr" xml:id="gi-subst" ident="subst" ns="http://www.tei-c.org/ns/1.0">
          <classes />
          <content autoPrefix="true">
            <alternate minOccurs="0" maxOccurs="unbounded">
              <elementRef key="add" minOccurs="1" maxOccurs="1" />
              <elementRef key="del" minOccurs="1" maxOccurs="1" />
            </alternate>
          </content>
          <constraintSpec ident="substContents1" scheme="schematron" xml:lang="en">
            <constraint>
              <sch:rule context="tei:subst">
                <sch:assert test="child::tei:add and (child::tei:del or child::tei:surplus)"> &lt; <sch:name />
                                    &gt; must have at least one child &lt;add&gt;
                                    and at least one child &lt;del&gt; or &lt;surplus&gt;.
                                </sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <attList org="group">
            <attDef ident="change" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="string" />
              </datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="NCName" />
              </datatype>
            </attDef>
          </attList>
        </elementSpec>
