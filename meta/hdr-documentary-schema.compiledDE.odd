              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="string" />
              </datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="req" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
