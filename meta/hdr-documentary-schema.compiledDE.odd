              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="integer" />
              </datatype>
            </attDef>
            <attDef ident="lry" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="integer" />
