              </datatype>
            </attDef>
            <attDef ident="attachment">
              <datatype>
                <dataRef key="teidata.enumerated" />
              </datatype>
              <valList type="open">
                <valItem ident="glued" />
                <valItem ident="pinned" />
                <valItem ident="sewn" />
              </valList>
            </attDef>
            <attDef ident="flipping">
              <datatype>
                <dataRef key="teidata.truthValue" />
              </datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude" rend="change" ident="zone" xml:id="gi-zone" module="transcr" ns="http://www.tei-c.org/ns/1.0">
          <desc versionDate="2018-04-15" xml:lang="de">beschreibt eine beliebige zweidimensionale
            Fläche innerhalb eines <gi>surface</gi>-Elements.</desc>
          <classes />
          <content autoPrefix="true">
            <elementRef key="zone" minOccurs="0" maxOccurs="unbounded" />
          </content>
          <attList org="group">
            <attDef ident="rotate" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0" />
            <attDef ident="points" mode="replace" usage="req" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
