        <elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude" rend="change" ident="facsimile" xml:id="gi-facsimile" module="transcr" ns="http://www.tei-c.org/ns/1.0">
          <classes />
          <content autoPrefix="true">
            <sequence minOccurs="1" maxOccurs="1">
              <elementRef key="graphic" minOccurs="1" maxOccurs="1" />
              <elementRef key="surface" minOccurs="1" maxOccurs="1" />
            </sequence>
          </content>
          <constraintSpec scheme="schematron" ident="no_facsimile_text_nodes" xml:lang="en">
            <constraint>
              <sch:rule context="tei:facsimile//tei:line | tei:facsimile//tei:zone">
                <sch:report test="child::text()[ normalize-space(.) ne '']">
                                    A
                                    &lt;facsimile&gt; element represents a text with images, thus
                                    transcribed text should not be present within it.
                                </sch:report>
              </sch:rule>
            </constraint>
            <!-- What about:
         * ellipses/supplied/text()
         * writing
         * label, formula, app, witDetail, metamark?
         * notatedMusic?
         * figure/[all-sorts-of-crazy-stuff-e.g.-entry]
         * addSpan, damageSpan, delSpan
         Or the fact that <front> and <back> (but not <body>) are
         permitted inside <facsimile>, and thus *anything* can be
         inside ther?
         See https://github.com/TEIC/TEI/issues/2363 -->
          </constraintSpec>
          <attList org="group">
            <attDef ident="xml:id" mode="replace" usage="opt" predeclare="false" ns="http://www.tei-c.org/ns/1.0">
              <datatype minOccurs="1" maxOccurs="1">
                <dataRef name="NCName" />
              </datatype>
            </attDef>
          </attList>
        </elementSpec>
