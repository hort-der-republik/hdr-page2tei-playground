            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="head" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="type" mode="replace" usage="req">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="graphic" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="height" mode="replace" usage="req">
              <datatype><dataRef name="NMTOKEN"/></datatype>
            </attDef>
            <attDef ident="url" mode="replace" usage="req">
              <datatype><dataRef name="NMTOKEN"/></datatype>
            </attDef>
            <attDef ident="width" mode="replace" usage="req">
              <datatype><dataRef name="NMTOKEN"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="lb" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="break" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="cb" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="n" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="title" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <textNode/>
          </content>
          <attList>
            <attDef ident="level" mode="delete"/>
            <attDef ident="type" mode="delete"/>
          </attList>
        </elementSpec>
        <elementSpec ident="l" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="lg" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="l" minOccurs="1" maxOccurs="unbounded"/>
          </content>
          <attList>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="TEI" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <sequence>
              <elementRef key="teiHeader"/>
              <elementRef key="facsimile"/>
              <elementRef key="text"/>
            </sequence>
          </content>
          <attList>
            <attDef ident="xml:lang" mode="replace" usage="req">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="version" mode="delete"/>
          </attList>
        </elementSpec>
        <elementSpec ident="text" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="body"/>
          </content>
          
        </elementSpec>
        <elementSpec ident="body" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="div"/>
          </content>
          
        </elementSpec>
        <elementSpec ident="div" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="0" maxOccurs="unbounded">
              <elementRef key="div"/>
              <elementRef key="metamark"/>
              <elementRef key="p"/>
              <elementRef key="byline"/>
              <elementRef key="cb"/>
              <elementRef key="dateline"/>
              <elementRef key="fw"/>
              <elementRef key="head"/>
              <elementRef key="anchor"/>
              <elementRef key="delSpan"/>
              <elementRef key="lb"/>
              <elementRef key="gap"/>
              <elementRef key="quote"/>
              <elementRef key="listTranspose"/>
            </alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="next" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="part" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="prev" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="type" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="byline" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inlineCore"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
