          </content>
          
        </elementSpec>
        <elementSpec ident="metamark" module="transcr" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
