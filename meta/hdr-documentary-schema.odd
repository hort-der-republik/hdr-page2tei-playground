<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:rng="http://relaxng.org/ns/structure/1.0">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>hdr-documentary-schema: Schema für die diplomatische TEI-Ausgabe von pagexml-to-tei.xsl</title>
      </titleStmt>
      <publicationStmt>
        <p>Aus diesem ODD wird meta/hdr-documentary-schema.rng erzeugt.</p>
      </publicationStmt>
      <sourceDesc>
        <p>Born digital; Anpassung von TEI P5 (tei:current).</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <head>hdr-documentary-schema</head>
      <p>Eng geführtes Dokumentations-Schema: Es lässt nur zu, was das Stylesheet erzeugt. Jedes Element ist eine
        Einschränkung des TEI-Elements gleichen Namens (Klassenzugehörigkeiten entfernt, Attribute und Inhalt
        explizit festgelegt), die erlaubte Sprache ist damit eine Teilmenge von TEI-All.</p>
      <schemaSpec ident="hdr-documentary-schema" start="TEI" source="tei:current" ns="http://www.tei-c.org/ns/1.0">
        <moduleRef key="header" include="teiHeader fileDesc titleStmt publicationStmt sourceDesc profileDesc creation change listChange"/>
        <moduleRef key="core" include="p hi quote sic corr choice gap add del unclear ptr head graphic lb cb title l lg"/>
        <moduleRef key="textstructure" include="TEI text body div byline dateline"/>
        <moduleRef key="gaiji" include="g"/>
        <moduleRef key="transcr" include="facsimile surface zone delSpan fw subst listTranspose metamark mod retrace transpose undo"/>
        <moduleRef key="linking" include="anchor seg"/>
        <moduleRef key="analysis" include="pc"/>
        <macroSpec ident="hdr.inlineCore" mode="add" module="tei">
          <desc xml:lang="de" versionDate="2026-11-13">Phrasen-Inhalt ohne quote (für byline, dateline und als Bestandteil von hdr.inline).</desc>
          <content>
            <alternate>
              <textNode/>
              <elementRef key="add"/>
              <elementRef key="anchor"/>
              <elementRef key="del"/>
              <elementRef key="delSpan"/>
              <elementRef key="gap"/>
              <elementRef key="hi"/>
              <elementRef key="lb"/>
              <elementRef key="metamark"/>
              <elementRef key="mod"/>
              <elementRef key="pc"/>
              <elementRef key="subst"/>
              <elementRef key="choice"/>
              <elementRef key="seg"/>
              <elementRef key="undo"/>
              <elementRef key="g"/>
              <elementRef key="retrace"/>
              <elementRef key="unclear"/>
              <elementRef key="listTranspose"/>
            </alternate>
          </content>
        </macroSpec>
        <macroSpec ident="hdr.inline" mode="add" module="tei">
          <desc xml:lang="de" versionDate="2026-11-13">Gemeinsamer Inline-Inhalt von p, hi, mod, del, seg, add, metamark, fw, head, l, retrace und unclear.</desc>
          <content>
            <alternate>
              <macroRef key="hdr.inlineCore"/>
              <elementRef key="quote"/>
            </alternate>
          </content>
        </macroSpec> 
        
        <elementSpec ident="teiHeader" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <sequence>
            <elementRef key="fileDesc"/>
            <elementRef key="profileDesc"/>
            </sequence>
          </content>
        </elementSpec>
          
        <elementSpec ident="fileDesc" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <sequence>
              <elementRef key="titleStmt"/>
              <elementRef key="publicationStmt"/>
              <elementRef key="sourceDesc"/>
            </sequence>
          </content>
        </elementSpec>

        <elementSpec ident="titleStmt" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="title"/>
          </content>
        </elementSpec>

        <elementSpec ident="publicationStmt" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded">
            <elementRef key="p"/>
            </alternate>
          </content>
        </elementSpec>

        <elementSpec ident="sourceDesc" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="p"/>
          </content>
        </elementSpec>

        <elementSpec ident="profileDesc" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="creation"/>
          </content>
        </elementSpec>
          
        <elementSpec ident="creation" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="listChange"/>
          </content>
        </elementSpec>
          
        <elementSpec ident="change" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <textNode/>
          </content>
          <attList>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="listChange" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded">
              <elementRef key="change"/>
            </alternate>
          </content>
        </elementSpec>
        
        
        <elementSpec ident="p" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <constraintSpec ident="p-attribute-im-text" scheme="schematron">
            <desc xml:lang="de">p braucht @change, @facs und @rendition nur innerhalb von text (nicht im teiHeader).</desc>
            <constraint>
              <sch:rule xmlns:sch="http://purl.oclc.org/dsdl/schematron" context="tei:text//tei:p">
                <sch:assert test="@change and @facs and @rendition">p innerhalb von text braucht @change, @facs und @rendition.</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
        <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="part" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>  
              <valList type="closed">
                <valItem ident="I"/>
                <valItem ident="F"/>
                <valItem ident="M"/>
              </valList>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="closed">
                <valItem ident="#antiqua"/>
                <valItem ident="#black-letter"/>
                <valItem ident="#bold"/>
                <valItem ident="#center"/>
                <valItem ident="#crosshead"/>
                <valItem ident="#handwritten"/>
                <valItem ident="#indent"/>
                <valItem ident="#kurrent"/>
                <valItem ident="#latin"/>
                <valItem ident="#left"/>
                <valItem ident="#undefined"/>
                <!-- add more values -->
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="hi" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="rendition" mode="replace" usage="req">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="open">
                <valItem ident="#bold"/>
                <valItem ident="#latin"/>
                <valItem ident="#letter-spacing"/>
                <valItem ident="#underline"/>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="quote" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate>
              <elementRef key="lg" minOccurs="1" maxOccurs="unbounded"/>
              <elementRef key="p" minOccurs="1" maxOccurs="unbounded"/>
            </alternate>
          </content>
          <attList>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="sic" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>  
          <attList>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="corr" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="type" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
              <valList type="closed">
                <valItem ident="emen"/>
                <valItem ident="norm"/>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="choice" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <sequence>
              <elementRef key="sic"/>
              <elementRef key="corr"/>
            </sequence>
          </content>
          <attList>
            <attDef ident="resp" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
              <valList type="open">
                <valItem ident="#edHdR"/>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="gap" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="extent" mode="replace" usage="opt">
              <datatype><dataRef name="integer"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="reason" mode="replace" usage="req">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="cut"/>
                <valItem ident="illegible"/>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="agent" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="add" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="place" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="above"/>
                <valItem ident="below"/>
                <valItem ident="inline"/>
                <valItem ident="overwritten"/>
              </valList>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="open">
                <valItem ident="#antiqua"/>
                <valItem ident="#kurrent"/>
                <valItem ident="#latin"/>
                <valItem ident="#rotate270"/>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="del" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="subtype" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="implicit"/>
              </valList>
            </attDef>
            <attDef ident="type" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="deselection"/>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="unclear" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="reason" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="cert" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="resp" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="agent" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="ptr" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="target" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="head" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="req">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="closed">
                <valItem ident="#black-letter"/>
                <valItem ident="#bold"/>
                <valItem ident="#center"/>
                <valItem ident="#large"/>
                <!-- add more values -->
              </valList>
            </attDef>
            <attDef ident="type" mode="replace" usage="req">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="main"/>
                <valItem ident="sub"/>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="graphic" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="height" mode="replace" usage="req">
              <datatype><dataRef name="NMTOKEN"/></datatype>
            </attDef>
            <attDef ident="url" mode="replace" usage="req">
              <datatype><dataRef name="NMTOKEN"/></datatype>
            </attDef>
            <attDef ident="width" mode="replace" usage="req">
              <datatype><dataRef name="NMTOKEN"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="lb" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="break" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="no"/>
              </valList>
            </attDef>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="type" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef><!-- for required lb-s, etc. -->
            <attDef ident="subtype" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="cb" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="n" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="title" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <textNode/>
          </content>
        </elementSpec>
        
        <elementSpec ident="l" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="lg" module="core" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="l" minOccurs="1" maxOccurs="unbounded"/>
          </content>
          <attList>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="req">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="TEI" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <sequence>
              <elementRef key="teiHeader"/>
              <elementRef key="facsimile"/>
              <elementRef key="text"/>
            </sequence>
          </content>
          <attList>
            <attDef ident="xml:lang" mode="replace" usage="req">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="de"/>
              </valList>
            </attDef>
            <attDef ident="version" mode="replace" usage="opt"/>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="text" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="body"/>
          </content>
          
          <attList>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="body" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="div"/>
          </content>  
          <attList>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="div" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="0" maxOccurs="unbounded">
              <elementRef key="div"/>
              <elementRef key="metamark"/>
              <elementRef key="p"/>
              <elementRef key="byline"/>
              <elementRef key="cb"/>
              <elementRef key="dateline"/>
              <elementRef key="fw"/>
              <elementRef key="head"/>
              <elementRef key="anchor"/>
              <elementRef key="gap"/>
              <elementRef key="quote"/>
            </alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="next" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="part" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="closed">
                <valItem ident="F"/>
                <valItem ident="M"/>
                <valItem ident="I"/>
              </valList>
            </attDef>
            <attDef ident="prev" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="type" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="add-block"/>
                <valItem ident="advertisement"/>
                <valItem ident="article"/>
                <valItem ident="newspaper-clipping"/>
                <valItem ident="notepad-paper"/>
                <valItem ident="print-proof"/>
                <valItem ident="print-publ"/>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="byline" module="textstructure" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inlineCore"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
