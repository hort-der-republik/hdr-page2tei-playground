        <elementSpec ident="metamark" module="transcr" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="function" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="closed">
                <valItem ident="addition">
                  <gloss xml:lang="de">Ergänzung</gloss>
                  <desc xml:lang="de">Markierung zur Einfügung von ergänztem Text</desc>
                </valItem>
                <valItem ident="deletion">
                  <gloss xml:lang="de">Tilgung</gloss>
                  <desc xml:lang="de">Markierung, die eine zu tilgende Stelle anzeigt</desc>
                </valItem>
                <valItem ident="font">
                  <gloss xml:lang="de">Drucktype</gloss>
                  <desc xml:lang="de">Markierung zur Angabe der Drucktype</desc>
                </valItem>
                <valItem ident="insertion">
                  <gloss xml:lang="de">Einfügung</gloss>
                  <desc xml:lang="de">Markierung, die den Ort einer Einfügung anzeigt</desc>
                </valItem>
                <valItem ident="intervention">
                  <gloss xml:lang="de">Eingriff</gloss>
                  <desc xml:lang="de">Markierung, die einen Eingriff anzeigt</desc>
                </valItem>
                <valItem ident="kerning">
                  <gloss xml:lang="de">Zeichenabstand verringern</gloss>
                  <desc xml:lang="de">Markierung, die zu großen Zeichenabstand anzeigt</desc>
                </valItem>
                <valItem ident="letter-spacing">
                  <gloss xml:lang="de">Spationierung</gloss>
                  <desc xml:lang="de">Markierung, die anzubringende Spationierung anzeigt</desc>
                </valItem>
                <valItem ident="line-spacing">
                  <gloss xml:lang="de">Zeilenabstand</gloss>
                  <desc xml:lang="de">Markierung, die zu erhöhenden Zeilenabstand anzeigt</desc>
                </valItem>
                <valItem ident="no-spacing">
                  <gloss xml:lang="de">Spationierung entfernen</gloss>
                  <desc xml:lang="de">Markierung, die zu entfernende Spationierung anzeigt</desc>
                </valItem>
                <valItem ident="paragraph">
                  <gloss xml:lang="de">Absatz</gloss>
                  <desc xml:lang="de">Markierung, die Beginn eines neuen Absatzes anzeigt</desc>
                </valItem>
                <valItem ident="print-instruction">
                  <gloss xml:lang="de">Druckanweisung</gloss>
                  <desc xml:lang="de">Markierung mit Druckanweisung</desc>
                </valItem>
                <valItem ident="relocation">
                  <gloss xml:lang="de">Verschiebung</gloss>
                  <desc xml:lang="de">Markierung, die das Ziel einer Verschiebung anzeigt</desc>
                </valItem>
                <valItem ident="selection">
                  <gloss xml:lang="de">Selektion</gloss>
                  <desc xml:lang="de">Markierung, die ausgewählte Textpassage angibt</desc>
                </valItem>
                <valItem ident="selection-end">
                  <gloss xml:lang="de">Ende der Selektion</gloss>
                  <desc xml:lang="de">Markierung, die das Ende einer ausgewählten Textpassage anzeigt</desc>
                </valItem>
                <valItem ident="selection-start">
                  <gloss xml:lang="de">Beginn der Selektion</gloss>
                  <desc xml:lang="de">Markierung, die den Beginn einer ausgewählten Textpassage anzeigt</desc>
                </valItem>
                <valItem ident="transposition">
                  <gloss xml:lang="de">Transposition</gloss>
                  <desc xml:lang="de">Markierung, die die Vertauschung zweier Textpassagen angibt</desc>
                </valItem>
                <valItem ident="unknown">
                  <gloss xml:lang="de">Unbekannt</gloss>
                  <desc xml:lang="de">Markierung mit unbekanntem Zweck</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="closed">
                <valItem ident="#kurrent">
                  <gloss xml:lang="de">Kurrent</gloss>
                  <desc xml:lang="de">Handschriftlicher Text in Kurrentschrift</desc>
                </valItem>
                <valItem ident="#latin">
                  <gloss xml:lang="de">Lateinschrift</gloss>
                  <desc xml:lang="de">Handschriftlicher Text in Lateinschrift</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="target" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="corresp" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
