<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:rng="http://relaxng.org/ns/structure/1.0">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>hdr-documentary-schema: Schema für die diplomatische TEI-Ausgabe von pagexml-to-tei.xsl</title>
      </titleStmt>
      <publicationStmt>
        <p>Aus diesem ODD wird meta/hdr-documentary-schema.rng erzeugt.</p>
      </publicationStmt>
      <sourceDesc>
        <p>Born digital; Anpassung von TEI P5 (tei:current).</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <head>hdr-documentary-schema</head>
      <p>Eng geführtes Dokumentations-Schema: Es lässt nur zu, was das Stylesheet erzeugt. Jedes Element ist eine
        Einschränkung des TEI-Elements gleichen Namens (Klassenzugehörigkeiten entfernt, Attribute und Inhalt
        explizit festgelegt), die erlaubte Sprache ist damit eine Teilmenge von TEI-All.</p>
      <schemaSpec ident="hdr-documentary-schema" start="TEI" source="tei:current" ns="http://www.tei-c.org/ns/1.0">
        <moduleRef key="header" include="teiHeader fileDesc titleStmt publicationStmt sourceDesc profileDesc creation change listChange"/>
        <moduleRef key="core" include="p hi quote sic corr choice gap add del unclear ptr head graphic lb cb title l lg"/>
        <moduleRef key="textstructure" include="TEI text body div byline dateline"/>
        <moduleRef key="gaiji" include="g"/>
        <moduleRef key="transcr" include="facsimile surface zone delSpan fw subst listTranspose metamark mod retrace transpose undo"/>
        <moduleRef key="linking" include="anchor seg"/>
        <moduleRef key="analysis" include="pc"/>
        <macroSpec ident="hdr.inlineCore" mode="add" module="tei">
          <desc xml:lang="de">Phrasen-Inhalt ohne quote (für byline, dateline und als Bestandteil von hdr.inline).</desc>
          <content>
            <alternate>
              <textNode/>
              <elementRef key="add"/>
              <elementRef key="anchor"/>
              <elementRef key="del"/>
              <elementRef key="delSpan"/>
              <elementRef key="gap"/>
              <elementRef key="hi"/>
              <elementRef key="lb"/>
              <elementRef key="metamark"/>
              <elementRef key="mod"/>
              <elementRef key="pc"/>
              <elementRef key="subst"/>
              <elementRef key="choice"/>
              <elementRef key="seg"/>
              <elementRef key="undo"/>
              <elementRef key="g"/>
              <elementRef key="retrace"/>
              <elementRef key="unclear"/>
              <elementRef key="listTranspose"/>
            </alternate>
          </content>
        </macroSpec>
        <macroSpec ident="hdr.inline" mode="add" module="tei">
          <desc xml:lang="de">Gemeinsamer Inline-Inhalt von p, hi, mod, del, seg, add, metamark, fw, head, l, retrace und unclear.</desc>
          <content>
            <alternate>
              <macroRef key="hdr.inlineCore"/>
              <elementRef key="quote"/>
            </alternate>
          </content>
        </macroSpec> 
        
        <elementSpec ident="teiHeader" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <sequence>
            <elementRef key="fileDesc"/>
            <elementRef key="profileDesc"/>
            </sequence>
          </content>
        </elementSpec>
          
        <elementSpec ident="fileDesc" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <sequence>
              <elementRef key="titleStmt"/>
              <elementRef key="publicationStmt"/>
              <elementRef key="sourceDesc"/>
            </sequence>
          </content>
        </elementSpec>

        <elementSpec ident="titleStmt" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="title"/>
          </content>
        </elementSpec>

        <elementSpec ident="publicationStmt" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded">
            <elementRef key="p"/>
            </alternate>
          </content>
        </elementSpec>

        <elementSpec ident="sourceDesc" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="p"/>
          </content>
        </elementSpec>

        <elementSpec ident="profileDesc" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="creation"/>
          </content>
        </elementSpec>
          
        <elementSpec ident="creation" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <elementRef key="listChange"/>
          </content>
        </elementSpec>
          
        <elementSpec ident="change" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <textNode/>
          </content>
          <attList>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="listChange" module="header" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded">
              <elementRef key="change"/>
            </alternate>
          </content>
        </elementSpec>
        
        
        <elementSpec ident="p" module="core" mode="change">
          <gloss xml:lang="de">Absatz</gloss>
          <desc xml:lang="de">Formal/visuell und semantisch abgesetzte Einheit</desc>
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <constraintSpec ident="p-attribute-im-text" scheme="schematron">
            <desc xml:lang="de">p braucht @change, @facs und @rendition nur innerhalb von text (nicht im teiHeader).</desc>
            <constraint>
              <sch:rule xmlns:sch="http://purl.oclc.org/dsdl/schematron" context="tei:text//tei:p">
                <sch:assert test="@change and @facs and @rendition">p innerhalb von text braucht @change, @facs und @rendition.</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
        <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="part" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>  
              <valList type="closed">
                <valItem ident="I">
                  <gloss xml:lang="de">Initial</gloss>
                  <desc xml:lang="de">Erster Abschnitt eines geteilten Absatzes</desc>
                </valItem>
                <valItem ident="F">
                  <gloss xml:lang="de">Final</gloss>
                  <desc xml:lang="de">Letzter Abschnitt eines geteilten Absatzes</desc>
                </valItem>
                <valItem ident="M">
                  <gloss xml:lang="de">Mittig</gloss>
                  <desc xml:lang="de">Mittlerer Abschnitt eines geteilten Absatzes</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="closed">
                <valItem ident="#antiqua">
                  <gloss xml:lang="de">Antiqua</gloss>
                  <desc xml:lang="de">In Antiqua gesetzter Drucktext</desc>
                </valItem>
                <valItem ident="#black-letter">
                  <gloss xml:lang="de">Fraktur</gloss>
                  <desc xml:lang="de">In Fraktur gesetzter Drucktext</desc>
                </valItem>
                <valItem ident="#bold">
                  <gloss xml:lang="de">Fettdruck</gloss>
                  <desc xml:lang="de">In Fettdruck gesetzter Drucktext</desc>
                </valItem>
                <valItem ident="#center">
                  <gloss xml:lang="de">Zentriert</gloss>
                  <desc xml:lang="de">Zentriert gesetzter Text</desc>
                </valItem>
                <valItem ident="#crosshead">
                  <gloss xml:lang="de">[Glosse: p/@rendition = #crosshead]</gloss>
                  <desc xml:lang="de">[Beschreibung: p/@rendition = #crosshead]</desc>
                </valItem>
                <valItem ident="#handwritten">
                  <gloss xml:lang="de">Handgeschrieben</gloss>
                  <desc xml:lang="de">Handgeschriebener Text</desc><!-- Streichkandidat -->
                </valItem>
                <valItem ident="#indent">
                  <gloss xml:lang="de">Einzug der ersten Zeile</gloss>
                  <desc xml:lang="de">Absatz mit Einzug der ersten Zeile</desc>
                </valItem>
                <valItem ident="#kurrent">
                  <gloss xml:lang="de">Kurrent</gloss>
                  <desc xml:lang="de">Handschriftlicher Text in Kurrentschrift</desc>
                </valItem>
                <valItem ident="#latin">
                  <gloss xml:lang="de">Lateinschrift</gloss>
                  <desc xml:lang="de">Handschriftlicher Text in Lateinschrift</desc>
                </valItem>
                <valItem ident="#left">
                  <gloss xml:lang="de">Abstand links</gloss>
                  <desc xml:lang="de">Absatz mit erhöhtem Randabstand links</desc>
                </valItem>
                <valItem ident="#undefined">
                  <gloss xml:lang="de">[Glosse: p/@rendition = #undefined]</gloss>
                  <desc xml:lang="de">[Beschreibung: p/@rendition = #undefined]</desc>
                </valItem>
                <!-- add more values -->
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="hi" module="core" mode="change">
          <gloss xml:lang="de">Hervorhebung</gloss>
          <desc xml:lang="de">Hervorgehobene oder visuell unterschiedene Passage</desc>
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="rendition" mode="replace" usage="req">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="open">
                <valItem ident="#bold">
                  <gloss xml:lang="de">Fettdruck</gloss>
                  <desc xml:lang="de">Hervorhebung durch Fettdruck</desc>
                </valItem>
                <valItem ident="#latin">
                  <gloss xml:lang="de">Lateinschrift</gloss>
                  <desc xml:lang="de">Passage in Lateinschrift (im Kontext von z. B. kurrent)</desc>
                </valItem>
                <valItem ident="#letter-spacing">
                  <gloss xml:lang="de">Spationierung</gloss>
                  <desc xml:lang="de">Hervorhebung durch erhöhten Zeichenabstand</desc>
                </valItem>
                <valItem ident="#underline">
                  <gloss xml:lang="de">Unterstreichung</gloss>
                  <desc xml:lang="de">Hervorhebung / Markierung durch Unterstreichung</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="quote" module="core" mode="change">
          <gloss xml:lang="de">Zitat</gloss>
          <desc xml:lang="de">Textblock bzw. Textpassage, die zitierten Text enthält.</desc>
          <classes mode="replace"/>
          <content>
            <alternate>
              <elementRef key="lg" minOccurs="1" maxOccurs="unbounded"/>
              <elementRef key="p" minOccurs="1" maxOccurs="unbounded"/>
            </alternate>
          </content>
          <attList>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="sic" module="core" mode="change">
          <gloss xml:lang="de">[Glosse: sic]</gloss>
          <desc xml:lang="de">[Beschreibung: sic]</desc>
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>  
          <attList>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="corr" module="core" mode="change">
          <gloss xml:lang="de">[Glosse: corr]</gloss>
          <desc xml:lang="de">[Beschreibung: corr]</desc>
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="type" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
              <valList type="closed">
                <valItem ident="emen">
                  <gloss xml:lang="de">[Glosse: corr/@type = emen]</gloss>
                  <desc xml:lang="de">[Beschreibung: corr/@type = emen]</desc>
                </valItem>
                <valItem ident="norm">
                  <gloss xml:lang="de">[Glosse: corr/@type = norm]</gloss>
                  <desc xml:lang="de">[Beschreibung: corr/@type = norm]</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="choice" module="core" mode="change">
          <gloss xml:lang="de">[Glosse: choice]</gloss>
          <desc xml:lang="de">[Beschreibung: choice]</desc>
          <classes mode="replace"/>
          <content>
            <sequence>
              <elementRef key="sic"/>
              <elementRef key="corr"/>
            </sequence>
          </content>
          <attList>
            <attDef ident="resp" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
              <valList type="open">
                <valItem ident="#edHdR">
                  <gloss xml:lang="de">[Glosse: choice/@resp = #edHdR]</gloss>
                  <desc xml:lang="de">[Beschreibung: choice/@resp = #edHdR]</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="gap" module="core" mode="change">
          <gloss xml:lang="de">[Glosse: gap]</gloss>
          <desc xml:lang="de">[Beschreibung: gap]</desc>
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="extent" mode="replace" usage="opt">
              <datatype><dataRef name="integer"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="reason" mode="replace" usage="req">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="cut">
                  <gloss xml:lang="de">[Glosse: gap/@reason = cut]</gloss>
                  <desc xml:lang="de">[Beschreibung: gap/@reason = cut]</desc>
                </valItem>
                <valItem ident="illegible">
                  <gloss xml:lang="de">[Glosse: gap/@reason = illegible]</gloss>
                  <desc xml:lang="de">[Beschreibung: gap/@reason = illegible]</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="agent" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="add" module="core" mode="change">
          <gloss xml:lang="de">[Glosse: add]</gloss>
          <desc xml:lang="de">[Beschreibung: add]</desc>
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="place" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="above">
                  <gloss xml:lang="de">[Glosse: add/@place = above]</gloss>
                  <desc xml:lang="de">[Beschreibung: add/@place = above]</desc>
                </valItem>
                <valItem ident="below">
                  <gloss xml:lang="de">[Glosse: add/@place = below]</gloss>
                  <desc xml:lang="de">[Beschreibung: add/@place = below]</desc>
                </valItem>
                <valItem ident="inline">
                  <gloss xml:lang="de">[Glosse: add/@place = inline]</gloss>
                  <desc xml:lang="de">[Beschreibung: add/@place = inline]</desc>
                </valItem>
                <valItem ident="overwritten">
                  <gloss xml:lang="de">[Glosse: add/@place = overwritten]</gloss>
                  <desc xml:lang="de">[Beschreibung: add/@place = overwritten]</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="open">
                <valItem ident="#antiqua">
                  <gloss xml:lang="de">[Glosse: add/@rendition = #antiqua]</gloss>
                  <desc xml:lang="de">[Beschreibung: add/@rendition = #antiqua]</desc>
                </valItem>
                <valItem ident="#kurrent">
                  <gloss xml:lang="de">[Glosse: add/@rendition = #kurrent]</gloss>
                  <desc xml:lang="de">[Beschreibung: add/@rendition = #kurrent]</desc>
                </valItem>
                <valItem ident="#latin">
                  <gloss xml:lang="de">[Glosse: add/@rendition = #latin]</gloss>
                  <desc xml:lang="de">[Beschreibung: add/@rendition = #latin]</desc>
                </valItem>
                <valItem ident="#rotate270">
                  <gloss xml:lang="de">[Glosse: add/@rendition = #rotate270]</gloss>
                  <desc xml:lang="de">[Beschreibung: add/@rendition = #rotate270]</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="del" module="core" mode="change">
          <gloss xml:lang="de">[Glosse: del]</gloss>
          <desc xml:lang="de">[Beschreibung: del]</desc>
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="subtype" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="implicit">
                  <gloss xml:lang="de">[Glosse: del/@subtype = implicit]</gloss>
                  <desc xml:lang="de">[Beschreibung: del/@subtype = implicit]</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="type" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="deselection">
                  <gloss xml:lang="de">[Glosse: del/@type = deselection]</gloss>
                  <desc xml:lang="de">[Beschreibung: del/@type = deselection]</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="unclear" module="core" mode="change">
          <gloss xml:lang="de">[Glosse: unclear]</gloss>
          <desc xml:lang="de">[Beschreibung: unclear]</desc>
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="reason" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="cert" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="resp" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="agent" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="ptr" module="core" mode="change">
          <gloss xml:lang="de">[Glosse: ptr]</gloss>
          <desc xml:lang="de">[Beschreibung: ptr]</desc>
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="target" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="head" module="core" mode="change">
          <gloss xml:lang="de">[Glosse: head]</gloss>
          <desc xml:lang="de">[Beschreibung: head]</desc>
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="facs" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="req">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="closed">
                <valItem ident="#black-letter">
                  <gloss xml:lang="de">[Glosse: head/@rendition = #black-letter]</gloss>
                  <desc xml:lang="de">[Beschreibung: head/@rendition = #black-letter]</desc>
                </valItem>
                <valItem ident="#bold">
                  <gloss xml:lang="de">[Glosse: head/@rendition = #bold]</gloss>
                  <desc xml:lang="de">[Beschreibung: head/@rendition = #bold]</desc>
                </valItem>
                <valItem ident="#center">
                  <gloss xml:lang="de">[Glosse: head/@rendition = #center]</gloss>
                  <desc xml:lang="de">[Beschreibung: head/@rendition = #center]</desc>
                </valItem>
                <valItem ident="#large">
                  <gloss xml:lang="de">[Glosse: head/@rendition = #large]</gloss>
                  <desc xml:lang="de">[Beschreibung: head/@rendition = #large]</desc>
                </valItem>
                <!-- add more values -->
              </valList>
            </attDef>
            <attDef ident="type" mode="replace" usage="req">
