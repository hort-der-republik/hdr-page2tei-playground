            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="open">
                <valItem ident="#kurrent">
                  <gloss xml:lang="de">Kurrent</gloss>
                  <desc xml:lang="de">Handschriftlicher Text in Kurrentschrift</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="transpose" module="transcr" mode="change">
          <classes mode="replace"/>
          <content>
            <sequence>
              <elementRef key="ptr"/>
              <elementRef key="ptr" minOccurs="1" maxOccurs="unbounded"/>
            </sequence>
          </content>
          <attList>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="undo" module="transcr" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="open">
                <valItem ident="#dotted-underline">
                  <gloss xml:lang="de">Gepunktete Unterstreichung</gloss>
                  <desc xml:lang="de">Rücknahme eines Eingriffs durch gepunktete Unterstreichung der Passage</desc>
                </valItem>
                <valItem ident="#strike-out">
                  <gloss xml:lang="de">Durchstreichung</gloss>
                  <desc xml:lang="de">Rücknahme eines Eingriffs durch Durchstreichung der Markierung</desc>
                </valItem>
                <valItem ident="#wavy-line">
                  <gloss xml:lang="de">Gewellte Unterstreichung</gloss>
                  <desc xml:lang="de">Rücknahme eines Eingriffs durch gewellte Unterstreichung der Passage</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="spanTo" mode="replace" usage="req">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="target" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="corresp" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="anchor" module="linking" mode="change">
          <classes mode="replace"/>
          <content>
            <empty/>
          </content>
          <attList>
            <attDef ident="type" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="deselection">
                  <gloss xml:lang="de">Ende der Aussonderung</gloss>
                  <desc xml:lang="de">Ende einer ausgesonderten Passage</desc>
                </valItem>
                <valItem ident="undo">
                  <gloss xml:lang="de">Ende der Rücknahme</gloss>
                  <desc xml:lang="de">Ende einer von einem zurückgenommenen Eingriff betroffenen Textpassage</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="req">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="seg" module="linking" mode="change">
          <classes mode="replace"/>
          <content>
            <alternate minOccurs="1" maxOccurs="unbounded"><macroRef key="hdr.inline"/></alternate>
          </content>
          <attList>
            <attDef ident="change" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="open">
                <valItem ident="#encircled">
                  <gloss xml:lang="de">Umrandet</gloss>
                  <desc xml:lang="de">Markierung eines Textsegments durch Umrandung</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="rendition" mode="replace" usage="opt">
              <datatype minOccurs="1" maxOccurs="unbounded"><dataRef name="token"/></datatype>
              <valList type="open">
                <valItem ident="#encircled"/>
              </valList>
            </attDef>
            <attDef ident="type" mode="replace" usage="req">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="relocation">
                  <gloss xml:lang="de">Zu verschiebendes Textsegment</gloss>
                </valItem>
                <valItem ident="#crosshead">
                  <gloss xml:lang="de">Zwischentitel</gloss>
                  <desc xml:lang="de">Titel, der keinen eigenen Textblock darstellt, sondern in den Fließtext integriert ist</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="subtype" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
            <attDef ident="corresp" mode="replace" usage="opt">
              <datatype><dataRef name="string"/></datatype>
            </attDef>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="pc" module="analysis" mode="change">
          <classes mode="replace"/>
          <content>
            <textNode/>
          </content>
          <attList>
            <attDef ident="force" mode="replace" usage="req">
              <datatype><dataRef name="NCName"/></datatype>
              <valList type="open">
                <valItem ident="weak">
                  <gloss xml:lang="de">‚Schwacher‘ Trennstrich</gloss>
                  <desc xml:lang="de">Trennstrich, der nicht der Worttrennung am Zeilenende, sondern der Trennung bei zusammengesetzten Nomen dient</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="unit" mode="replace" usage="opt"/>
            <attDef ident="pre"  mode="replace" usage="opt"/>
            <attDef ident="xml:id" mode="replace" usage="opt">
              <datatype><dataRef name="NCName"/></datatype>
            </attDef>
          </attList>
        </elementSpec>
      </schemaSpec>
    </body>
  </text>
</TEI>
