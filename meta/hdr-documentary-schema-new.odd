                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="rendition" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="surface" module="transcr" mode="change">
                    <gloss xml:lang="de">Oberfläche</gloss>
                    <desc xml:lang="de"> Oberfläche eines Textträgers (meist von einem Faksimile
                        oder Teil eines Faksimiles repräsentiert). </desc>
                    <content>
                        <alternate minOccurs="0" maxOccurs="unbounded">
                            <elementRef key="surface"/>
                            <elementRef key="zone"/>
                        </alternate>
                    </content>
                    <attList>
                        <attDef ident="attachment" mode="delete"/>
