                </elementSpec>
                <elementSpec ident="fw" module="transcr" mode="change">
                    <gloss xml:lang="de">Beiwerk</gloss>
                    <desc xml:lang="de"> Enthält Elemente wie Kolumnentitel (Kopf- oder Fußzeile),
