                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                </elementSpec>
                <elementSpec ident="facsimile" module="transcr" mode="change">
                    <gloss xml:lang="de">Faksimile</gloss>
                    <desc xml:lang="de">Visuelle Repräsentation eines Textträgers.</desc>
                    <content>
