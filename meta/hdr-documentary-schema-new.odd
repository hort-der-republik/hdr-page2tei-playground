                                </valItem>
                                <valItem ident="#intervention">
                                    <gloss xml:lang="de">Korrekturzeichen</gloss>
                                </valItem>
                                <valItem ident="#kerning">
                                    <gloss xml:lang="de">Korrekturzeichen ‚Zeichenabstand
                                        verringern‘</gloss>
                                </valItem>
                                <valItem ident="#relocation">
                                    <gloss xml:lang="de">Korrekturzeichen ‚Verschieben‘</gloss>
