                                <valItem ident="#black-letter">
                                    <gloss xml:lang="de">Fraktur</gloss>
                                    <desc xml:lang="de">In Fraktur gesetzter Drucktext.</desc>
                                </valItem>
                                <valItem ident="#bold">
                                    <gloss xml:lang="de">Fettdruck</gloss>
                                    <desc xml:lang="de">In Fettdruck gesetzter Titel.</desc>
                                </valItem>
                                <valItem ident="#center">
                                    <gloss xml:lang="de">Zentriert</gloss>
                                    <desc xml:lang="de">Zentriert gesetzter Titel.</desc>
                                </valItem>
                                <valItem ident="#large">
                                    <gloss xml:lang="de">Schriftgröße erhöht</gloss>
                                    <desc xml:lang="de">In größerer Type gesetzter Titel.</desc>
                                </valItem>
                                <!-- add more values -->
                            </valList>
                        </attDef>
                        <attDef ident="type" mode="change" usage="req">
                            <valList type="semi" mode="replace">
                                <valItem ident="main">
                                    <gloss xml:lang="de">Hauptüberschrift</gloss>
                                    <desc xml:lang="de"> Hauptsächliche Überschrift eines Texts im
                                        Gegensatz zu Unterüberschriften oder Zwischenüberschriften.
                                    </desc>
                                </valItem>
                                <valItem ident="sub">
                                    <gloss xml:lang="de">Unterüberschrift</gloss>
                                    <desc xml:lang="de">[Beschreibung: head/@type = sub].</desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="corresp" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                        <attDef ident="subtype" mode="delete"/>
                    </attList>
                </elementSpec>
