                        <attDef ident="lrx" mode="delete"/>
                        <attDef ident="lry" mode="delete"/>
                        <attDef ident="subtype" mode="delete"/>
                        <attDef ident="points" mode="change" usage="req"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="delSpan" module="transcr" mode="change">
                    <gloss xml:lang="de">Getilgte Textpassage</gloss>
                    <desc xml:lang="de"> Markiert den Anfang einer (längeren) getilgten Textpassage. </desc>
                    <classes mode="change">
                        <memberOf key="att.dimensions" mode="delete"/>
                    </classes>
