                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                        <attDef ident="subtype" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="subst" module="transcr" mode="change">
                    <gloss xml:lang="de">Substitution</gloss>
                    <desc xml:lang="de"> Ersetzung, bestehend aus einer oder mehreren Tilgungen und
                        einer oder mehreren Ergänzungen, die als zusammengehörig erachtet werden. </desc>
                    <classes mode="change">
                        <memberOf key="att.dimensions" mode="delete"/>
                    </classes>
                    <content>
                        <alternate minOccurs="1" maxOccurs="unbounded">
                            <elementRef key="add"/>
                            <elementRef key="del"/>
                        </alternate>
                    </content>
                    <attList>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="facs" mode="delete"/>
                        <attDef ident="corresp" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="rendition" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="listTranspose" module="transcr" mode="change">
                    <gloss xml:lang="de">Liste von Transpositionen</gloss>
                    <desc xml:lang="de"> Enthält eine Liste der im Text durchgeführten
                        Transpositionen. </desc>
                    <content>
                        <elementRef key="transpose" minOccurs="1" maxOccurs="unbounded"/>
                    </content>
                    <attList>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="change" mode="delete"/>
                        <attDef ident="facs" mode="delete"/>
                        <attDef ident="corresp" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="rendition" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="metamark" module="transcr" mode="change">
                    <gloss xml:lang="de">Markierung</gloss>
                    <desc xml:lang="de"> Außerhalb des Textflusses, stellt einen Eingriff im Sinne
                        einer Angabe für die Lektüre oder Verarbeitung des Textes dar. </desc>
                    <classes mode="change">
                        <memberOf key="att.placement" mode="delete"/>
                        <memberOf key="att.spanning" mode="delete"/>
                    </classes>
                    <content>
                        <macroRef key="hdr.inline"/>
                    </content>
                    <attList>
                        <attDef ident="function" mode="change">
                            <valList type="closed" mode="replace">
                                <valItem ident="addition">
                                    <gloss xml:lang="de">Ergänzung</gloss>
                                    <desc xml:lang="de">Markierung zur Einfügung von ergänztem
                                        Text.</desc>
                                </valItem>
                                <valItem ident="deletion">
                                    <gloss xml:lang="de">Tilgung</gloss>
                                    <desc xml:lang="de"> Markierung, die eine zu tilgende Stelle
                                        anzeigt. </desc>
                                </valItem>
                                <valItem ident="font">
                                    <gloss xml:lang="de">Drucktype</gloss>
                                    <desc xml:lang="de">Markierung zur Angabe der Drucktype.</desc>
                                </valItem>
                                <valItem ident="insertion">
                                    <gloss xml:lang="de">Einfügung</gloss>
                                    <desc xml:lang="de"> Markierung, die den Ort einer Einfügung
                                        anzeigt. </desc>
                                </valItem>
                                <valItem ident="intervention">
                                    <gloss xml:lang="de">Eingriff</gloss>
                                    <desc xml:lang="de">Markierung, die einen Eingriff
                                        anzeigt.</desc>
                                </valItem>
                                <valItem ident="kerning">
                                    <gloss xml:lang="de">Zeichenabstand verringern</gloss>
                                    <desc xml:lang="de"> Markierung, die zu großen Zeichenabstand
                                        anzeigt. </desc>
                                </valItem>
                                <valItem ident="letter-spacing">
                                    <gloss xml:lang="de">Spationierung</gloss>
                                    <desc xml:lang="de"> Markierung, die anzubringende Spationierung
                                        anzeigt. </desc>
                                </valItem>
                                <valItem ident="line-spacing">
                                    <gloss xml:lang="de">Zeilenabstand</gloss>
                                    <desc xml:lang="de"> Markierung, die zu erhöhenden Zeilenabstand
                                        anzeigt. </desc>
                                </valItem>
                                <valItem ident="no-spacing">
                                    <gloss xml:lang="de">Spationierung entfernen</gloss>
                                    <desc xml:lang="de"> Markierung, die zu entfernende
                                        Spationierung anzeigt. </desc>
                                </valItem>
                                <valItem ident="paragraph">
                                    <gloss xml:lang="de">Absatz</gloss>
                                    <desc xml:lang="de"> Markierung, die Beginn eines neuen Absatzes
                                        anzeigt. </desc>
                                </valItem>
                                <valItem ident="print-instruction">
                                    <gloss xml:lang="de">Druckanweisung</gloss>
                                    <desc xml:lang="de">Markierung mit Druckanweisung.</desc>
                                </valItem>
                                <valItem ident="relocation">
                                    <gloss xml:lang="de">Verschiebung</gloss>
                                    <desc xml:lang="de"> Markierung, die das Ziel einer Verschiebung
                                        anzeigt. </desc>
                                </valItem>
                                <valItem ident="selection">
                                    <gloss xml:lang="de">Selektion</gloss>
                                    <desc xml:lang="de"> Markierung, die ausgewählte Textpassage
                                        angibt. </desc>
                                </valItem>
                                <valItem ident="selection-end">
                                    <gloss xml:lang="de">Ende der Selektion</gloss>
                                    <desc xml:lang="de"> Markierung, die das Ende einer ausgewählten
                                        Textpassage anzeigt. </desc>
                                </valItem>
                                <valItem ident="selection-start">
                                    <gloss xml:lang="de">Beginn der Selektion</gloss>
                                    <desc xml:lang="de"> Markierung, die den Beginn einer
                                        ausgewählten Textpassage anzeigt. </desc>
                                </valItem>
                                <valItem ident="transposition">
                                    <gloss xml:lang="de">Transposition</gloss>
                                    <desc xml:lang="de"> Markierung, die die Vertauschung zweier
                                        Textpassagen angibt. </desc>
                                </valItem>
                                <valItem ident="unknown">
                                    <gloss xml:lang="de">Unbekannt</gloss>
                                    <desc xml:lang="de">Markierung mit unbekanntem Zweck.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="rendition" mode="change">
                            <valList type="closed" mode="replace">
                                <valItem ident="#kurrent">
                                    <gloss xml:lang="de">Kurrent</gloss>
                                    <desc xml:lang="de">Handschriftlicher Text in
                                        Kurrentschrift.</desc>
                                </valItem>
                                <valItem ident="#latin">
                                    <gloss xml:lang="de">Lateinschrift</gloss>
                                    <desc xml:lang="de">Handschriftlicher Text in
                                        Lateinschrift.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="mod" module="transcr" mode="change">
                    <gloss xml:lang="de">Änderung</gloss>
                    <desc xml:lang="de">Weist eine zu ändernde Textstelle aus.</desc>
                    <classes mode="change">
                        <memberOf key="att.dimensions" mode="delete"/>
                        <memberOf key="att.spanning" mode="delete"/>
                        <memberOf key="att.typed" mode="delete"/>
                    </classes>
                    <content>
                        <macroRef key="hdr.inline"/>
                    </content>
                    <attList>
                        <attDef ident="rendition" mode="change" usage="req">
                            <valList type="semi" mode="replace">
                                <valItem ident="#underline">
                                    <gloss xml:lang="de">Unterstreichung</gloss>
                                    <desc xml:lang="de"> Bezeichnung des zu modifizierenden Texts
                                        durch Unterstreichung. </desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="facs" mode="delete"/>
                        <attDef ident="corresp" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="retrace" module="transcr" mode="change">
                    <gloss xml:lang="de">Nachgezogener Text</gloss>
                    <desc xml:lang="de"> Text, der in einem weiteren Überarbeitungsschritt zum Zweck
                        etwa der Verdeutlichung nachgezogen wurde. </desc>
                    <classes mode="change">
                        <memberOf key="att.dimensions" mode="delete"/>
                        <memberOf key="att.spanning" mode="delete"/>
                    </classes>
                    <content>
                        <macroRef key="hdr.inline"/>
                    </content>
                    <attList>
                        <attDef ident="rendition" mode="change">
                            <valList type="semi" mode="replace">
                                <valItem ident="#kurrent">
                                    <gloss xml:lang="de">Kurrent</gloss>
                                    <desc xml:lang="de">Handschriftlicher Text in
                                        Kurrentschrift.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="facs" mode="delete"/>
                        <attDef ident="corresp" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="transpose" module="transcr" mode="change">
                    <gloss xml:lang="de">Transposition</gloss>
                    <desc xml:lang="de"> Enthält die Angaben zur intendierten neuen Reihenfolge von
                        transponierten Textteilen. </desc>
                    <attList>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="change" mode="delete"/>
                        <attDef ident="facs" mode="delete"/>
                        <attDef ident="corresp" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="rendition" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="undo" module="transcr" mode="change">
                    <gloss xml:lang="de">Rücknahme eines Eingriffs</gloss>
                    <desc xml:lang="de"> Weist in irgendeiner Form (Streichung einer Markierung,
                        gepunktete Unterstreichung einer Tilgung) die Rücknahme eines oder mehrere
                        Eingriffe in den Text aus. </desc>
                    <classes mode="change">
                        <memberOf key="att.dimensions" mode="delete"/>
                    </classes>
                    <attList>
                        <attDef ident="rendition" mode="change">
                            <valList type="semi" mode="replace">
                                <valItem ident="#dotted-underline">
                                    <gloss xml:lang="de">Gepunktete Unterstreichung</gloss>
                                    <desc xml:lang="de"> Rücknahme eines Eingriffs durch gepunktete
                                        Unterstreichung der Passage. </desc>
                                </valItem>
                                <valItem ident="#strike-out">
                                    <gloss xml:lang="de">Durchstreichung</gloss>
                                    <desc xml:lang="de"> Rücknahme eines Eingriffs durch
                                        Durchstreichung der Markierung. </desc>
                                </valItem>
                                <valItem ident="#wavy-line">
                                    <gloss xml:lang="de">Gewellte Unterstreichung</gloss>
                                    <desc xml:lang="de"> Rücknahme eines Eingriffs durch gewellte
                                        Unterstreichung der Passage. </desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="spanTo" mode="change" usage="req"/>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="facs" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="anchor" module="linking" mode="change">
                    <attList>
                        <attDef ident="type" mode="change">
                            <valList type="semi" mode="replace">
                                <valItem ident="deselection">
                                    <gloss xml:lang="de">Ende der Aussonderung</gloss>
                                    <desc xml:lang="de">Ende einer ausgesonderten Passage.</desc>
                                </valItem>
                                <valItem ident="undo">
                                    <gloss xml:lang="de">Ende der Rücknahme</gloss>
                                    <desc xml:lang="de"> Ende einer von einem zurückgenommenen
                                        Eingriff betroffenen Textpassage. </desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="xml:id" mode="change" usage="req"/>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="rendition" mode="delete"/>
                        <attDef ident="subtype" mode="delete"/>
                        <attDef ident="change" mode="delete"/>
                        <attDef ident="facs" mode="delete"/>
                        <attDef ident="corresp" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="seg" mode="change">
                    <classes mode="change">
                        <memberOf key="att.segLike" mode="delete"/>
                    </classes>
                    <content>
                        <macroRef key="hdr.inline"/>
                    </content>
                    <attList>
                        <attDef ident="rendition" mode="change">
                            <valList type="semi" mode="replace">
                                <valItem ident="#encircled">
                                    <gloss xml:lang="de">Umrandet</gloss>
                                    <desc xml:lang="de">Markierung eines Textsegments durch
                                        Umrandung.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="type" mode="change" usage="req">
                            <valList type="semi" mode="replace">
                                <valItem ident="relocation">
                                    <gloss xml:lang="de">Zu verschiebendes Textsegment</gloss>
                                </valItem>
                                <valItem ident="#crosshead">
                                    <gloss xml:lang="de">Zwischentitel</gloss>
                                    <desc xml:lang="de">Titel, der keinen eigenen Textblock
                                        darstellt, sondern in den Fließtext integriert ist.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="facs" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                    </attList>
                </elementSpec>
                <elementSpec ident="pc" module="analysis" mode="change">
                    <classes mode="change">
                        <memberOf key="att.segLike" mode="delete"/>
                        <memberOf key="att.typed" mode="delete"/>
                    </classes>
                    <content>
                        <textNode/>
                    </content>
                    <attList>
                        <attDef ident="n" mode="delete"/>
                        <attDef ident="xml:lang" mode="delete"/>
                        <attDef ident="change" mode="delete"/>
                        <attDef ident="facs" mode="delete"/>
                        <attDef ident="corresp" mode="delete"/>
                        <attDef ident="next" mode="delete"/>
                        <attDef ident="prev" mode="delete"/>
                        <attDef ident="cert" mode="delete"/>
                        <attDef ident="resp" mode="delete"/>
                        <attDef ident="source" mode="delete"/>
                        <attDef ident="rendition" mode="delete"/>
                        <attDef ident="force" mode="change" usage="req">
                            <valList type="semi" mode="replace">
                                <valItem ident="weak">
                                    <gloss xml:lang="de">‚Schwacher‘ Trennstrich</gloss>
                                    <desc xml:lang="de">Trennstrich, der nicht der Worttrennung am
                                        Zeilenende, sondern der Trennung bei zusammengesetzten Nomen
                                        dient.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                </elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>
