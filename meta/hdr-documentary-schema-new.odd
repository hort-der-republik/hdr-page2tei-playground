                                </valItem>
                                <valItem ident="notepad-paper">
                                    <gloss xml:lang="de">Konzeptpapier</gloss>
                                    <desc xml:lang="de">Konzeptpapier (Oktavformat).</desc>
                                </valItem>
                                <valItem ident="print-proof">
