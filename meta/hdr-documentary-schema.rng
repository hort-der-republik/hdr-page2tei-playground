<?xml version='1.0' encoding='UTF-8'?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" ns="http://www.tei-c.org/ns/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <element name="TEI">
      <attribute>
        <name ns="http://www.w3.org/XML/1998/namespace">lang</name>
        <data type="NCName" />
      </attribute>
      <element name="teiHeader">
        <element name="fileDesc">
          <element name="titleStmt">
            <element name="title">
              <text />
            </element>
          </element>
          <element name="publicationStmt">
            <ref name="p" />
          </element>
          <element name="sourceDesc">
            <ref name="p" />
          </element>
        </element>
        <element name="profileDesc">
          <element name="creation">
            <element name="listChange">
              <oneOrMore>
                <element name="change">
                  <attribute>
                    <name ns="http://www.w3.org/XML/1998/namespace">id</name>
                    <data type="NCName" />
                  </attribute>
                  <text />
                </element>
              </oneOrMore>
            </element>
          </element>
        </element>
      </element>
      <element name="facsimile">
        <element name="graphic">
          <attribute name="height">
            <data type="NMTOKEN" />
          </attribute>
          <attribute name="url">
            <data type="NMTOKEN" />
          </attribute>
          <attribute name="width">
            <data type="NMTOKEN" />
          </attribute>
        </element>
        <ref name="surface" />
      </element>
      <element name="text">
        <element name="body">
          <ref name="div" />
        </element>
      </element>
    </element>
  </start>
  <define name="inline">
    <choice>
      <ref name="inlineCore" />
      <ref name="quote" />
    </choice>
  </define>
  <define name="p">
    <element name="p">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="facs" />
      </optional>
      <optional>
        <attribute name="part">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute name="rendition" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="surface">
    <element name="surface">
      <optional>
        <attribute name="lrx">
          <data type="integer" />
        </attribute>
      </optional>
      <optional>
        <attribute name="lry">
          <data type="integer" />
        </attribute>
      </optional>
      <optional>
        <attribute name="points" />
      </optional>
      <optional>
        <attribute name="source">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute name="type">
          <data type="NCName" />
        </attribute>
      </optional>
      <attribute>
        <name ns="http://www.w3.org/XML/1998/namespace">id</name>
        <data type="NCName" />
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="surface" />
          <ref name="zone" />
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="div">
    <element name="div">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="facs" />
      </optional>
      <optional>
        <attribute name="next" />
      </optional>
      <optional>
        <attribute name="part">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute name="prev" />
      </optional>
      <optional>
        <attribute name="type">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="div" />
          <ref name="metamark" />
          <ref name="p" />
          <ref name="byline" />
          <ref name="cb" />
          <ref name="dateline" />
          <ref name="fw" />
          <ref name="head" />
          <ref name="anchor" />
          <ref name="delSpan" />
          <ref name="lb" />
          <ref name="gap" />
          <ref name="quote" />
          <ref name="listTranspose" />
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="subst">
    <element name="subst">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="add" />
          <ref name="del" />
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="del">
    <element name="del">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="subtype">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute name="type">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="anchor">
    <element name="anchor">
      <optional>
        <attribute name="type">
          <data type="NCName" />
        </attribute>
      </optional>
      <attribute>
        <name ns="http://www.w3.org/XML/1998/namespace">id</name>
        <data type="NCName" />
      </attribute>
    </element>
  </define>
  <define name="lb">
    <element name="lb">
      <optional>
        <attribute name="break">
          <data type="NCName" />
        </attribute>
      </optional>
      <attribute name="facs" />
    </element>
  </define>
  <define name="mod">
    <element name="mod">
      <optional>
        <attribute name="change" />
      </optional>
      <attribute name="rend">
        <data type="NCName" />
      </attribute>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="undo">
    <element name="undo">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="rend">
          <data type="NCName" />
        </attribute>
      </optional>
      <attribute name="spanTo" />
      <optional>
        <attribute name="target" />
      </optional>
      <optional>
        <attribute name="corresp" />
      </optional>
    </element>
  </define>
  <define name="delSpan">
    <element name="delSpan">
      <attribute name="change" />
      <attribute name="spanTo" />
      <attribute name="type">
        <data type="NCName" />
      </attribute>
      <attribute>
        <name ns="http://www.w3.org/XML/1998/namespace">id</name>
        <data type="NCName" />
      </attribute>
    </element>
  </define>
  <define name="gap">
    <element name="gap">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="extent">
          <data type="integer" />
        </attribute>
      </optional>
      <optional>
        <attribute name="facs" />
      </optional>
      <attribute name="reason">
        <data type="NCName" />
      </attribute>
      <optional>
        <attribute name="rendition" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
    </element>
  </define>
  <define name="pc">
    <element name="pc">
      <attribute name="force">
        <data type="NCName" />
      </attribute>
      <text />
    </element>
  </define>
  <define name="hi">
    <element name="hi">
      <attribute name="rend">
        <data type="NCName" />
      </attribute>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="add">
    <element name="add">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="facs" />
      </optional>
      <optional>
        <attribute name="place">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute name="rendition" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="metamark">
    <element name="metamark">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="facs" />
      </optional>
      <optional>
        <attribute name="function">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute name="rendition" />
      </optional>
      <optional>
        <attribute name="target" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute name="corresp" />
      </optional>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="zone">
    <element name="zone">
      <attribute name="points" />
      <optional>
        <attribute name="type">
          <data type="NCName" />
        </attribute>
      </optional>
      <attribute>
        <name ns="http://www.w3.org/XML/1998/namespace">id</name>
        <data type="NCName" />
      </attribute>
      <zeroOrMore>
        <ref name="zone" />
      </zeroOrMore>
    </element>
  </define>
  <define name="g">
    <element name="g">
      <attribute name="ref" />
    </element>
  </define>
  <define name="inlineCore">
    <choice>
      <text />
      <ref name="add" />
      <ref name="anchor" />
      <ref name="del" />
      <ref name="delSpan" />
      <ref name="gap" />
      <ref name="hi" />
      <ref name="lb" />
      <ref name="metamark" />
      <ref name="mod" />
      <ref name="pc" />
      <ref name="subst" />
      <ref name="choiceSicCorr" />
      <ref name="seg" />
      <ref name="undo" />
      <ref name="g" />
      <ref name="retrace" />
      <ref name="unclear" />
      <ref name="listTranspose" />
    </choice>
  </define>
  <define name="choiceSicCorr">
    <element name="choice">
      <element name="sic">
        <data type="NCName" />
      </element>
      <element name="corr">
        <data type="NCName" />
      </element>
    </element>
  </define>
  <define name="quote">
    <element name="quote">
      <choice>
        <element name="lg">
          <attribute name="facs" />
          <oneOrMore>
            <element name="l">
              <attribute name="facs" />
              <oneOrMore>
                <ref name="inline" />
              </oneOrMore>
            </element>
          </oneOrMore>
        </element>
        <oneOrMore>
          <ref name="p" />
        </oneOrMore>
      </choice>
    </element>
  </define>
  <define name="seg">
    <element name="seg">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="rend">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute name="rendition" />
      </optional>
      <attribute name="type">
        <data type="NCName" />
      </attribute>
      <optional>
        <attribute name="subtype">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute name="corresp" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="retrace">
    <element name="retrace">
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="rendition" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="unclear">
    <element name="unclear">
      <optional>
        <attribute name="reason" />
      </optional>
      <optional>
        <attribute name="cert" />
      </optional>
      <optional>
        <attribute name="resp" />
      </optional>
      <optional>
        <attribute name="change" />
      </optional>
      <optional>
        <attribute name="rendition" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="ptr">
    <element name="ptr">
      <attribute name="target" />
    </element>
  </define>
  <define name="listTranspose">
    <element name="listTranspose">
      <element name="transpose">
        <ref name="ptr" />
        <oneOrMore>
          <ref name="ptr" />
        </oneOrMore>
      </element>
    </element>
  </define>
  <define name="fw">
    <element name="fw">
      <optional>
        <attribute name="change" />
      </optional>
      <attribute name="facs" />
      <optional>
        <attribute name="rendition" />
      </optional>
      <optional>
        <attribute name="type">
          <data type="NCName" />
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="head">
    <element name="head">
      <optional>
        <attribute name="change" />
      </optional>
      <attribute name="facs" />
      <attribute name="rendition" />
      <attribute name="type">
        <data type="NCName" />
      </attribute>
      <oneOrMore>
        <ref name="inline" />
      </oneOrMore>
    </element>
  </define>
  <define name="byline">
    <element name="byline">
      <optional>
        <attribute name="change" />
      </optional>
      <attribute name="facs" />
      <optional>
        <attribute name="rendition" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inlineCore" />
      </oneOrMore>
    </element>
  </define>
  <define name="dateline">
    <element name="dateline">
      <optional>
        <attribute name="change" />
      </optional>
      <attribute name="facs" />
      <optional>
        <attribute name="rendition" />
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName" />
        </attribute>
      </optional>
      <oneOrMore>
        <ref name="inlineCore" />
      </oneOrMore>
    </element>
  </define>
  <define name="cb">
    <element name="cb">
      <attribute name="facs" />
      <attribute name="n" />
    </element>
  </define>
</grammar>